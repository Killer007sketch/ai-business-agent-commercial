DATABASE_URL=sqlite:///./commercial.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
BUSINESS_MANAGER_MODEL=gpt-5-mini
BUSINESS_CONFIG_PATH=

# Optional email integration (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=AI Business Agent
# Safe defaults: inbound email is stored with 0 OpenAI calls.
EMAIL_ANALYZE_INBOUND=false
# Requires EMAIL_ANALYZE_INBOUND=true. Keep false until explicitly enabled.
EMAIL_AUTO_REPLY=false
